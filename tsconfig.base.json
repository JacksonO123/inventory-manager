{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "customConditions": ["@homelab/source"],
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["node"],
    "target": "es2022",
    "paths": {
      "@homelab/core-db-utils": ["./packages/core-db-utils/src/index.ts"],
      "@homelab/core-db-utils/db": ["./packages/core-db-utils/src/db.ts"],
      "@homelab/core-db-utils/schema": ["./packages/core-db-utils/src/schema.ts"],
      "@homelab/environments": ["./packages/environments/src/index.ts"],
      "@homelab/api-contracts/web": ["./packages/api-contracts/src/web/index.ts"],
      "@homelab/environments/db": ["./packages/environments/src/apps/db/index.ts"],
      "@homelab/api-contracts/schemas": ["./packages/api-contracts/src/schemas/index.ts"]
    }
  }
}
